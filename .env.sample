# App configs
APP_NAME="React FastAPI Dashboard"
APP_DOMAIN="http://localhost:8000"
APP_PORT=8000
APP_DEBUG=True
LOG_LEVEL="INFO"
ALLOWED_ORIGINS='["*"]'

# Directory configs
DATA_DIR="./data"

# Database configs
# enable echo all SQL queries to console
DATABASE_DEBUG=False
# for development - will drop all data when set to TRUE
DATABASE_REBUILD=False

# SQLite Database URL
DATABASE_URL="sqlite+aiosqlite:///./fastapi_app.db"

# PostgreSQL Database URL (sync + async)
#DATABASE_URL="postgresql+psycopg://postgres:123456@localhost:5432/fastapi_app"

# PostgreSQL Database URL (async only)
#DATABASE_URL="postgresql+asyncpg://postgres:123456@localhost:5432/fastapi_app"

# Auth Configs
COOKIE_BASED_AUTH=True
# 7 days
JWT_LIFETIME_SEC=604800
# openssl rand -hex 32
JWT_SECRET_KEY="jwt-secret-key"

# Email support configs
EMAIL_SUPPORT_ENABLE=False
SMTP_USER="sender@gmail.com"
SMTP_PASSWORD="gmail-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Email send configs
EMAIL_FROM_NAME="FastAPI Dashboard"
CONTACT_SUPPORT_URL="mailto:support@company.com"
REGISTRATION_EMAIL_ENABLE=False
VERIFICATION_EMAIL_ENABLE=True
FORGOT_PASSWORD_EMAIL_ENABLE=True

# Unit Test Configs
TEST_EMAIL_TO="recipient@gmail.com"
